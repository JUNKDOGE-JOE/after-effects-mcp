      "ancestrySnapshotCodeSnapshot": true,
      "wholeChainFinalRead": true,
      "currentUserOnly": true,
      "nativeExecutionOnly": true,
      "rejectionBackendAccessCount": 0
    },
    "caller": {
      "adobeTeamId": "JQ525L2MZD",
