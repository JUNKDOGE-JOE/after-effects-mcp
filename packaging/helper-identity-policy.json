        "ae-mcp-platform-helper"
      ],
      "brokerDirectParentSigningIdentifier": "com.adobe.cep.CEPHtmlEngine Helper (Renderer)",
      "brokerRequiredAncestorSigningIdentifier": "com.adobe.cep.CEPHtmlEngine"
    }
  },
  "windows": {
