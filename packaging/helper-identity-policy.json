    "keychainAccountPattern": "^provider:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:[a-z][a-z0-9_-]{0,31}:v1$",
    "authorization": {
      "publicConnectionIdentityOnly": true,
      "processGenerationDoubleRead": true,
